# ---- Groq (LLM) -------------------------------------------------------------
# Optional; without a key, only rule-based checks run.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODE=groq

# ---- GitHub OAuth for one-run private profile analysis ----------------------
# Create an OAuth App; callback: http://localhost:8000/settings/github/callback/
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/settings/github/callback/

# ---- Shared secret between Django and the AI service ------------------------
AI_SERVICE_TOKEN=replace-with-a-long-random-secret

# ---- RAG embeddings ---------------------------------------------------------
EMBEDDING_BACKEND=onnx

# ---- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_TIME_ZONE=Asia/Kolkata

# ---- Email for account verification and password resets ---------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=your-verified-sender@example.com

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=repointel
POSTGRES_USER=repointel
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# ---- Optional tuning --------------------------------------------------------
MAX_SOURCE_FILES=10
MAX_CHUNKS_PER_REVIEWER=1
LLM_CONCURRENCY=1
